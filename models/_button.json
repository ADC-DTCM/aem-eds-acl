{
  "definitions": [
    {
      "title": "Button",
      "id": "button",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/button/v1/button",
            "template": {
              "model": "button",
              "linkType": "primary",
              "classes": "",
              "disabled": false,
              "openInNewTab": false
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "button",
      "modelFields": [
        "linkType",
        "link",
        "linkText",
        "linkTitle",
        "icon",
        "iconPosition",
        "classes",
        "disabled",
        "openInNewTab"
      ],
      "fields": [
        {
          "component": "select",
          "name": "linkType",
          "label": "Variation",
          "valueType": "string",
          "value": "primary",
          "description": "Default is Primary. Link is a text link (no button chrome, no icon).",
          "options": [
            {
              "name": "Primary",
              "value": "primary"
            },
            {
              "name": "Secondary",
              "value": "secondary"
            },
            {
              "name": "Outline",
              "value": "outline"
            },
            {
              "name": "Ghost",
              "value": "ghost"
            },
            {
              "name": "Ghost Inverted",
              "value": "ghost-inverted"
            },
            {
              "name": "Destructive",
              "value": "destructive"
            },
            {
              "name": "Link",
              "value": "link"
            }
          ]
        },
        {
          "component": "aem-content",
          "name": "link",
          "label": "Link",
          "valueType": "string",
          "value": "",
          "multi": false,
          "description": "Select a page from this site (not DAM assets).",
          "validation": {
            "rootPath": "/content/aem-eds-acl/"
          }
        },
        {
          "component": "text",
          "name": "linkText",
          "label": "Text",
          "valueType": "string",
          "description": "Optional. Leave empty for an icon-only button."
        },
        {
          "component": "text",
          "name": "linkTitle",
          "label": "Title",
          "valueType": "string",
          "description": "Accessible name. Required for icon-only buttons."
        },
        {
          "component": "text",
          "name": "icon",
          "label": "Icon",
          "valueType": "string",
          "description": "Icon name from /icons (without .svg), e.g. search. Visual picker is MODP-66.",
          "condition": {
            "!=": [
              {
                "var": "linkType"
              },
              "link"
            ]
          }
        },
        {
          "component": "select",
          "name": "iconPosition",
          "label": "Icon Position",
          "valueType": "string",
          "value": "icon-left",
          "description": "Default is Left. Not used for the Link variation.",
          "options": [
            {
              "name": "Left",
              "value": "icon-left"
            },
            {
              "name": "Right",
              "value": "icon-right"
            }
          ],
          "condition": {
            "!=": [
              {
                "var": "linkType"
              },
              "link"
            ]
          }
        },
        {
          "component": "multiselect",
          "name": "classes",
          "label": "Shape",
          "valueType": "string",
          "maxSize": 1,
          "description": "Default uses 8px radius. Rounded is the pill shape. Size follows the viewport (Small / Default / Large / Extra-Large).",
          "options": [
            {
              "name": "Default",
              "value": ""
            },
            {
              "name": "Rounded",
              "value": "round"
            }
          ]
        },
        {
          "component": "boolean",
          "name": "openInNewTab",
          "label": "Open in new tab",
          "valueType": "boolean",
          "value": false
        },
        {
          "component": "boolean",
          "name": "disabled",
          "label": "Disabled",
          "valueType": "boolean",
          "value": false
        }
      ]
    }
  ]
}
